#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: log-archive <log-directory>"
    exit 1
fi

TARGET_DIR=$1

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist."
    exit 1
fi

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
ARCHIVE_DEST="./archived_logs"
ARCHIVE_NAME="logs_archive_${TIMESTAMP}.tar.gz"
ARCHIVE_PATH="${ARCHIVE_DEST}/${ARCHIVE_NAME}"
LOG_FILE="${ARCHIVE_DEST}/archive_record.log"

mkdir -p "$ARCHIVE_DEST"

# --warning=no-file-changed flag warning ko hide kar dega
tar --warning=no-file-changed -czPf "$ARCHIVE_PATH" "$TARGET_DIR"
TAR_EXIT_CODE=$?

# tar exit code 0 = pure success, 1 = files changed while reading (which is acceptable for live logs)
if [ $TAR_EXIT_CODE -eq 0 ] || [ $TAR_EXIT_CODE -eq 1 ]; then
    echo "Successfully compressed logs to: $ARCHIVE_PATH"
    echo "[$(date +"%Y-%m-%d %H:%M:%S")] Archived '$TARGET_DIR' -> '$ARCHIVE_NAME'" >> "$LOG_FILE"
else
    echo "Error: Failed to compress the logs. Exit code: $TAR_EXIT_CODE"
    exit 1
fi
